{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest --run",
    "test:unit:watch": "vitest",
    "test:e2e": "node ./scripts/run-e2e.mjs",
    "test:e2e:chromium": "node ./scripts/run-e2e.mjs --project=chromium",
    "test:e2e:chrome": "node ./scripts/run-e2e.mjs --project=chrome",
    "prepare:pages": "node ./scripts/prepare-pages.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:oxlint:fix lint:eslint:fix",
    "lint:check": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:eslint:fix": "eslint . --fix --cache --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.91.0",
    "prettier": "3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0",
    "pnpm": "10.28.0"
  }
}
